{
  "name": "agent-under-cover",
  "private": true,
  "type": "module",
  "description": "Serious game Undercover autour de l'IA responsable, 100 % statique (GitHub Pages).",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "python3 -m http.server 8000",
    "docker:build": "docker build -t undercover:local .",
    "docker:run": "docker run --rm -p 8080:8080 --read-only --tmpfs /tmp --cap-drop ALL --security-opt no-new-privileges undercover:local",
    "k8s:render": "kubectl kustomize deploy/kubernetes"
  }
}
